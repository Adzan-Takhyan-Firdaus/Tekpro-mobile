<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLogoHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Tekpro"
            android:textSize="32sp"
            android:fontFamily="@font/russo_one"
            android:textColor="#5E5E5E" />

        <ImageView
            android:id="@+id/iconUser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_user"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="User Profile" />

    </RelativeLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/headerLayout"
        android:background="#D9D9D9" />

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dividerHeader"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btnMenuHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="home"
            android:textSize="16sp"
            android:fontFamily="@font/poppins"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingEnd="20dp"
            android:paddingBottom="5dp"
            android:background="@drawable/underline_active" />

        <TextView
            android:id="@+id/btnMenuCreate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="create"
            android:textSize="16sp"
            android:fontFamily="@font/poppins"
            android:textColor="#000000"
            android:paddingStart="20dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <EditText
        android:id="@+id/etSearchHome"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_below="@id/menuLayout"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="#D9D9D9"
        android:hint="Search error..."
        android:paddingStart="15dp"
        android:fontFamily="@font/poppins"
        android:textSize="16sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvArticles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/etSearchHome"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</RelativeLayout>